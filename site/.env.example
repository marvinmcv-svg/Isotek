# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://isoteklatam.com

# Sanity (admin portal). Leave empty to run from the local seed content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Read token only needed for draft previews; never expose a write token to the client.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that triggers /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact form email delivery (https://resend.com). Without it the form returns 503 and shows direct channels.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@isoteklatam.com
CONTACT_FROM_EMAIL=web@isoteklatam.com

# Optional analytics (GA4 measurement ID, e.g. G-XXXXXXX). The current site uses Google Site Kit.
NEXT_PUBLIC_GA_ID=
